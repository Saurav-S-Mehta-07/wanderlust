 <% layout("/layouts/boilerplate.ejs")  %>

    <!-- filters -->
    <div id="filters" class="mt-3">
         <a href="/listings/?category=trending" class="filter">
           <i class="fa-solid fa-fire"></i>
           <p>Trending</p>
         </a>

         <a href="/listings/?category=rooms" class="filter">
           <i class="fa-solid fa-bed"></i>
           <p>Rooms</p>
         </a>

          <a href="/listings/?category=iconic cities" class="filter">
           <i class="fa-solid fa-mountain-city"></i>
           <p>Iconic Cities</p>
          </a>

         <a href="/listings/?category=mountains" class="filter">
           <i class="fa-solid fa-mountain"></i>
           <p>Mountains</p>
         </a>

         <a href="/listings/?category=castles" class="filter">
           <i class="fa-brands fa-fort-awesome"></i>
           <p>Castles</p>
         </a>

          <a href="/listings/?category=amazing pools" class="filter">
           <i class="fa-solid fa-person-swimming"></i>
           <p>Amazing Pools</p>
          </a>

         <a href="/listings/?category=forests" class="filter">
           <i class="fa-solid fa-tree"></i>
           <p>Forests</p>
         </a>

         <a href="/listings/?category=farms" class="filter">
           <i class="fa-solid fa-cow"></i>
           <p>Farms</p>
         </a>

          <a href="/listings/?category=camping" class="filter">
           <i class="fa-solid fa-campground"></i>
           <p>Camping</p>
          </a>

          <a href="/listings/?category=arctic" class="filter">
             <i class="fa-solid fa-snowman"></i>
             <p>Arctic</p>
          </a>

          <div class="tags-toggle ms-md-auto">
            <div class="form-check-reverse form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
              <label class="form-check-label" for="switchCheckDefault">Display Total after Taxes</label>
            </div>
          </div>
    </div><hr>

    <!-- listings -->
    <div class="cards row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-2">
      <% for(let listing of allListings) { %>
        <a href="/listings/<%=listing._id%>" class="listing-link">
           <div class="card col listing-card">
             <img src="<%=listing.image.url%>" class="card-img-top" alt="Listing-Image">

              <div class="card-img-overlay"></div>

             <div class="card-body">
               <p>
                 <b><%=listing.title%></b>
                <br>
                &#8377; <%=listing.price.toLocaleString("en-IN") %>/night
                <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
               </p>
              </div>
           </div>
        </a>
      <% } %>
    </div>

  <%- include("../includes/chatbot") %>

